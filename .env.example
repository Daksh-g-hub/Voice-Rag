# Voice-Enabled RAG Configuration

# LLM Configuration (Groq LPU recommended for sub-150ms TTFB)
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=512

# Speech-To-Text (Sarvam AI for Indic/English or local Whisper)
SARVAM_API_KEY=your_sarvam_api_key_here
STT_PROVIDER=sarvam  # options: sarvam, local_mock

# Vector Database (Qdrant)
QDRANT_STORAGE_PATH=./data/qdrant_db
COLLECTION_NAME=msmarco_xi_hierarchical
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Guardrails & Retrieval Thresholds
RELEVANCE_SCORE_THRESHOLD=0.62
ENABLE_RERANKER=true
RERANK_SCORE_THRESHOLD=0.70
TOP_K_CHILDREN=5
MAX_PARENT_CONTEXTS=3

# Server Settings
HOST=0.0.0.0
PORT=8000
